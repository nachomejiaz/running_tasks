{
  "compilerOptions": {
    "target": "ES2019",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "outFile": "dist/app.js",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
